<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- Hyva theme: swap the Luma per-method paymentinfo templates for the shared
             TokenBaseHyvaCheckout ones, and attach the Commerce Hub Checkout SDK payment pane.
             Carat's Luma form block (ParadoxLabs\Carat\Block\Customer\Form) does not override
             _toHtml/_template, so a plain layout retemplate (as CyberSource does) is sufficient;
             no remove-and-replace is needed. -->
        <referenceBlock name="tokenbase_manage_paradoxlabs_carat" template="ParadoxLabs_TokenBaseHyvaCheckout::customer/method.phtml"/>
        <referenceBlock name="tokenbase_manage_paradoxlabs_carat_cards" template="ParadoxLabs_TokenBaseHyvaCheckout::customer/cards.phtml"/>
        <referenceBlock name="tokenbase_manage_paradoxlabs_carat_form" template="ParadoxLabs_TokenBaseHyvaCheckout::customer/form.phtml">
            <block class="ParadoxLabs\CaratHyvaCheckout\Block\Customer\PaymentPane" name="tokenbase_manage_paradoxlabs_carat_form_pane" as="payment_pane" template="ParadoxLabs_CaratHyvaCheckout::customer/form/cc.phtml"/>
        </referenceBlock>
    </body>
</page>
